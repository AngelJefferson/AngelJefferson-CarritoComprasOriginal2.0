@{
    ViewBag.Title = "Dashboard";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f4f7f6;
        overflow-x: hidden;
    }

    .dashboard-container {
        padding: 1.5rem;
    }

    .dashboard-title {
        font-weight: 700;
        color: #003d99;
    }

    /* Tarjetas de Resumen */
    .card-stats {
        border: none;
        border-radius: 12px;
        transition: transform 0.2s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.04);
    }

        .card-stats:hover {
            transform: translateY(-3px);
        }

    .icon-shape {
        width: 45px;
        height: 45px;
        background-color: rgba(255,255,255,0.25);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Sección Principal */
    .card-main {
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        background: #fff;
    }

    .filter-zone {
        background-color: #f9fbff;
        border-radius: 10px;
        padding: 1rem !important;
        margin-bottom: 1rem;
        border: 1px solid #eef2f8;
    }

    /* Ajuste de Tabla */
    .table td, .table th {
        padding: 0.75rem;
        font-size: 0.9rem;
    }
</style>

<div class="dashboard-container">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="dashboard-title m-0">Resumen de Negocio</h2>
            <p class="text-muted small mb-0">Panel de control y métricas generales</p>
        </div>
        <span class="badge bg-white text-primary border p-2 shadow-sm">
            <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>

    <div class="row mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card card-stats bg-primary text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold text-uppercase">Clientes</div>
                        <h3 class="mb-0 fw-bold" id="totalcliente">0</h3>
                    </div>
                    <div class="icon-shape"><i class="fas fa-users fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card card-stats bg-warning text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold text-uppercase">Ventas</div>
                        <h3 class="mb-0 fw-bold" id="totalventa">0</h3>
                    </div>
                    <div class="icon-shape"><i class="fas fa-shopping-bag fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card card-stats bg-dark text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold text-uppercase">Productos</div>
                        <h3 class="mb-0 fw-bold" id="totalproducto">0</h3>
                    </div>
                    <div class="icon-shape"><i class="fas fa-boxes fa-lg"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 mb-4">
            <div class="card card-main p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="fas fa-history me-2 text-primary"></i>Historial de Ventas</h5>

                    <form action="@Url.Action("ExportarVenta","Home")" method="post" id="formExportar">
                        <input type="hidden" name="fechainicio" id="h_inicio" />
                        <input type="hidden" name="fechafin" id="h_fin" />
                        <input type="hidden" name="idtransaccion" id="h_idtransaccion" />

                        <div class="btn-group">
                            <button class="btn btn-outline-success btn-sm" type="button" onclick="exportar()">
                                <i class="fas fa-file-excel me-1"></i> Excel
                            </button>                            
                        </div>
                    </form>
                </div>

                <div class="row g-2 filter-zone align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label small fw-bold">Fecha Inicio</label>
                        <input class="form-control form-control-sm" type="text" id="txtfechainicio" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small fw-bold">Fecha Fin</label>
                        <input class="form-control form-control-sm" type="text" id="txtfechafin" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small fw-bold">Id Transacción</label>
                        <input class="form-control form-control-sm" type="text" id="txtidtransaccion" placeholder="Opcional..." />
                    </div>
                    <div class="col-sm-2">
                        <button class="btn btn-primary btn-sm w-100" id="btnbuscar" type="button">
                            <i class="fas fa-search me-1"></i> Buscar
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tabla" class="table table-hover table-sm border" style="width:100%">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cant.</th>
                                <th>Total</th>
                                <th>ID Transacción</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4 mb-4">
            <div class="card card-main p-4 h-100">
                <h5 class="fw-bold mb-4 text-center">Distribución de Registros</h5>
                <div style="position: relative; height:250px;">
                    <canvas id="myPieChart"></canvas>
                </div>
                <div class="mt-4 p-3 bg-light rounded text-center">
                    <p class="small text-muted mb-0">Visualización de la proporción actual de datos en la base de datos.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var tabladata;
        var myPieChart;

        $(document).ready(function () {
            // Inicializar Datepickers
            $("#txtfechainicio").datepicker({ dateFormat: 'dd/mm/yy' }).datepicker('setDate', new Date());
            $("#txtfechafin").datepicker({ dateFormat: 'dd/mm/yy' }).datepicker('setDate', new Date());

            // Cargar contadores y gráfico
            jQuery.ajax({
                url: '@Url.Action("VistaDashBoard", "Home")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    var objeto = data.resultado;
                    $("#totalcliente").text(objeto.TotalCliente);
                    $("#totalventa").text(objeto.TotalVenta);
                    $("#totalproducto").text(objeto.TotalProducto);

                    initChart(objeto.TotalCliente, objeto.TotalVenta, objeto.TotalProducto);
                }
            });

            // Configurar Datatable
            var UrlDefault = '@Url.Action("ListaReporte", "Home")' +
                "?fechainicio=" + $("#txtfechainicio").val() +
                "&fechafin=" + $("#txtfechafin").val();

            tabladata = $('#tabla').DataTable({
                responsive: true,
                ordering: false,
                pageLength: 5,
                ajax: {
                    url: UrlDefault,
                    type: "GET",
                    datatype: "json"
                },
                columns: [
                    { "data": "FechaVenta" },
                    { "data": "Cliente" },
                    { "data": "Producto" },
                    { "data": "Precio" },
                    { "data": "Cantidad" },
                    { "data": "Total" },
                    { "data": "IdTransaccion" }
                ],
                language: { url: "https://cdn.datatables.net/plug-ins/1.11.3/i18n/es_es.json" }
            });
        });

        // Botón Buscar
        $("#btnbuscar").on("click", function () {
            var nueva_url = '@Url.Action("ListaReporte", "Home")' +
                "?fechainicio=" + $("#txtfechainicio").val() +
                "&fechafin=" + $("#txtfechafin").val() +
                "&idtransaccion=" + $("#txtidtransaccion").val();

            tabladata.ajax.url(nueva_url).load();
        });

        // Función para Exportar Excel
        function exportar() {
            $("#h_inicio").val($("#txtfechainicio").val());
            $("#h_fin").val($("#txtfechafin").val());
            $("#h_idtransaccion").val($("#txtidtransaccion").val());

            $("#formExportar").submit();
        }

        // Gráfico
        function initChart(c, v, p) {
            var ctx = document.getElementById('myPieChart').getContext('2d');
            myPieChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Clientes', 'Ventas', 'Productos'],
                    datasets: [{
                        data: [c, v, p],
                        backgroundColor: ['#0d6efd', '#ffc107', '#212529'],
                        hoverOffset: 15
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }
    </script>
}
