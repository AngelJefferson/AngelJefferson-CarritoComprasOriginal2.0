@{
    ViewBag.Title = "Catalogo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }

    .product-card .card-img-top {
        height: 200px;
        object-fit: contain;
        padding: 1rem;
        background: #f8f9fa;
    }

    .product-card .card-body {
        display: flex;
        flex-direction: column;
    }

    .product-card .card-title {
        font-size: 0.95rem;
        font-weight: 600;
        min-height: 2.4rem;
    }

    .product-card .product-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: #198754;
    }

    .product-card .btn-add-cart {
        margin-top: auto;
    }

    .sidebar-category {
        cursor: pointer;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        transition: background 0.15s;
    }

    .sidebar-category:hover,
    .sidebar-category.active {
        background-color: #212529;
        color: #fff;
    }

    .product-img-placeholder {
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e9ecef;
        color: #adb5bd;
        font-size: 3rem;
    }

    #searchInput {
        border-radius: 2rem;
        padding-left: 2.5rem;
    }

    .search-wrapper {
        position: relative;
    }

    .search-wrapper i {
        position: absolute;
        left: 0.85rem;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
    }

    .loading-spinner {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }
</style>

<div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-search me-1"></i>Buscar
            </div>
            <div class="card-body">
                <div class="search-wrapper mb-3">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" id="searchInput" placeholder="Buscar productos..." autocomplete="off" />
                </div>

                <h6 class="fw-bold text-uppercase text-muted mb-2">
                    <i class="fas fa-tags me-1"></i>Categorias
                </h6>
                <div id="listaCategorias">
                    <div class="sidebar-category active" data-id="0">
                        <i class="fas fa-th-large me-1"></i>Todas
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0"><i class="fas fa-boxes me-2"></i>Productos</h4>
            <span class="badge bg-secondary" id="contadorProductos">0 productos</span>
        </div>

        <div id="loadingProductos" class="loading-spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando productos...</p>
        </div>

        <div class="row g-3" id="gridProductos"></div>

        <div id="sinProductos" class="text-center py-5" style="display:none;">
            <i class="fas fa-box-open fa-3x text-muted mb-3 d-block"></i>
            <p class="text-muted fs-5">No se encontraron productos</p>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var categoriaActual = 0;
        var busquedaTimer;

        // Load categories
        function cargarCategorias() {
            $.ajax({
                url: '@Url.Action("ListarCategorias", "Tienda")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $.each(data.data, function (i, cat) {
                        var el = '<div class="sidebar-category" data-id="' + cat.IdCategoria + '">';
                        el += '<i class="fas fa-tag me-1"></i>' + cat.Descripcion;
                        el += '</div>';
                        $("#listaCategorias").append(el);
                    });
                }
            });
        }

        // Load products
        function cargarProductos(idCategoria, busqueda) {
            $("#loadingProductos").show();
            $("#gridProductos").html("");
            $("#sinProductos").hide();

            $.ajax({
                url: '@Url.Action("ListarProductos", "Tienda")',
                type: 'GET',
                data: { idCategoria: idCategoria || 0, busqueda: busqueda || "" },
                dataType: 'json',
                success: function (data) {
                    $("#loadingProductos").hide();
                    var productos = data.data;
                    $("#contadorProductos").text(productos.length + " productos");

                    if (productos.length === 0) {
                        $("#sinProductos").show();
                        return;
                    }

                    var html = "";
                    $.each(productos, function (i, p) {
                        var imgSrc = "";
                        if (p.Base64 && p.Extension && p.Base64.length > 0) {
                            imgSrc = "data:image/" + p.Extension.replace(".", "") + ";base64," + p.Base64;
                        } else if (p.UrlImagen && p.UrlImagen.startsWith("http")) {
                            imgSrc = p.UrlImagen;
                        }

                        html += '<div class="col-sm-6 col-lg-4">';
                        html += '  <div class="card product-card shadow-sm">';

                        if (imgSrc) {
                            html += '    <img src="' + imgSrc + '" class="card-img-top" alt="' + p.Nombre + '" style="object-fit:cover;" />';
                        } else {
                            html += '    <div class="product-img-placeholder"><i class="fas fa-image"></i></div>';
                        }

                        html += '    <div class="card-body">';
                        html += '      <h6 class="card-title">' + p.Nombre + '</h6>';
                        html += '      <span class="badge bg-secondary mb-2">' + p.Marca + '</span>';

                        if (p.Descripcion) {
                            html += '      <p class="text-muted small mb-2" style="min-height:2rem;">' + p.Descripcion.substring(0, 80) + '</p>';
                        }

                        html += '      <div class="product-price mb-2">$' + p.Precio.toFixed(2) + '</div>';
                        html += '      <small class="text-muted mb-2 d-block">Stock: ' + p.Stock + '</small>';
                        html += '      <button class="btn btn-dark btn-sm btn-add-cart w-100" data-id="' + p.IdProducto + '">';
                        html += '        <i class="fas fa-cart-plus me-1"></i>Agregar al carrito';
                        html += '      </button>';
                        html += '    </div>';
                        html += '  </div>';
                        html += '</div>';
                    });

                    $("#gridProductos").html(html);
                },
                error: function () {
                    $("#loadingProductos").hide();
                    $("#sinProductos").show();
                }
            });
        }

        // Category click
        $(document).on("click", ".sidebar-category", function () {
            $(".sidebar-category").removeClass("active");
            $(this).addClass("active");
            categoriaActual = $(this).data("id");
            cargarProductos(categoriaActual, $("#searchInput").val());
        });

        // Search with debounce
        $("#searchInput").on("keyup", function () {
            clearTimeout(busquedaTimer);
            var texto = $(this).val();
            busquedaTimer = setTimeout(function () {
                cargarProductos(categoriaActual, texto);
            }, 400);
        });

        // Add to cart
        $(document).on("click", ".btn-add-cart", function () {
            var idProducto = $(this).data("id");
            var btn = $(this);
            btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i>');

            $.ajax({
                url: '@Url.Action("AgregarCarrito", "Tienda")',
                type: 'POST',
                data: { idProducto: idProducto, cantidad: 1 },
                dataType: 'json',
                success: function (data) {
                    btn.prop("disabled", false).html('<i class="fas fa-cart-plus me-1"></i>Agregar al carrito');

                    if (data.mensaje === "LOGIN_REQUIRED") {
                        window.location.href = '@Url.Action("Index", "Acceso")?returnUrl=/Tienda';
                        return;
                    }

                    if (data.resultado) {
                        actualizarBadgeCarrito();
                        abrirCarrito();
                    } else {
                        alert(data.mensaje || "No se pudo agregar al carrito");
                    }
                },
                error: function () {
                    btn.prop("disabled", false).html('<i class="fas fa-cart-plus me-1"></i>Agregar al carrito');
                }
            });
        });

        // Init
        $(document).ready(function () {
            cargarCategorias();
            cargarProductos(0, "");
        });
    </script>
}
